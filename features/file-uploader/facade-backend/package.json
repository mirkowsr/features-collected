    "@nestjs/platform-express": "^11.0.0",
    "@repo/backend-aws-s3": "workspace:*",
    "@repo/backend-validation": "workspace:*",
    "@repo/utils": "workspace:*",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^2.0.1",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.0.0",
